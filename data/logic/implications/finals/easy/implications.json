    {
      "question": "What is another name for if-then?",
      "answer": "implication",
      "alternatives": [
        "conditional"
      ],
      "explanation": "If-then is called implication.",
      "id": "impl_impl_e_finals_000"
    },
    {
      "question": "What is the symbol for if-then?",
      "answer": "→",
      "alternatives": [
        "⇒"
      ],
      "explanation": "→ represents implication.",
      "id": "impl_impl_e_finals_001"
    },
    {
      "question": "What is the first part of p→q called?",
      "answer": "antecedent",
      "alternatives": [
        "hypothesis"
      ],
      "explanation": "Antecedent comes before arrow.",
      "id": "impl_impl_e_finals_002"
    },
    {
      "question": "What is the second part of p→q called?",
      "answer": "consequent",
      "alternatives": [
        "conclusion"
      ],
      "explanation": "Consequent follows arrow.",
      "id": "impl_impl_e_finals_003"
    },
    {
      "question": "What switches p→q to q→p?",
      "answer": "converse",
      "alternatives": [],
      "explanation": "Converse swaps hypothesis and conclusion.",
      "id": "impl_impl_e_finals_004"
    },
    {
      "question": "What negates both parts of p→q?",
      "answer": "inverse",
      "alternatives": [],
      "explanation": "Inverse is ¬p→¬q.",
      "id": "impl_impl_e_finals_005"
    },
    {
      "question": "What switches and negates p→q?",
      "answer": "contrapositive",
      "alternatives": [],
      "explanation": "Contrapositive is ¬q→¬p.",
      "id": "impl_impl_e_finals_006"
    },
    {
      "question": "What is the symbol for if and only if?",
      "answer": "↔",
      "alternatives": [
        "⇔"
      ],
      "explanation": "↔ represents biconditional.",
      "id": "impl_impl_e_finals_007"
    },
    {
      "question": "What means both directions are true?",
      "answer": "biconditional",
      "alternatives": [
        "if and only if",
        "iff"
      ],
      "explanation": "Biconditional is mutual implication.",
      "id": "impl_impl_e_finals_008"
    },
    {
      "question": "Under what condition is an implication p→q false?",
      "answer": "true antecedent and false consequent",
      "alternatives": [
        "p true and q false",
        "true hypothesis and false conclusion"
      ],
      "explanation": "An implication is false only when the antecedent is true but the consequent is false.",
      "id": "impl_impl_e_finals_009"
    },
    {
      "question": "What does 'iff' abbreviate?",
      "answer": "if and only if",
      "alternatives": [
